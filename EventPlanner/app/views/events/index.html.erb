<p style="color: green"><%= notice %></p>

<% content_for :title, "Events" %>

<h1>Your Events</h1>
<div id="events">
  <% @organizedEvents.each do |event| %>
    <%= render event %>
    <p>
      <%= link_to "Show this event", event %>
    </p>
  <% end %>
</div>
<%= link_to "Make a new event", new_event_path %>

<h1>Registered Events</h1>
<div id="events">
  <% @registeredEvents.each do |event| %>
    <%= render event %>
    <p>
      <%= link_to "Show this event", event %>
    </p>
  <% end %>
</div>
<%= link_to "Register for a new event", new_event_path %>
