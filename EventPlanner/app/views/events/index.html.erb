<p style="color: green"><%= notice %></p>

<% content_for :title, "Events" %>

<h1>Find New Events</h1>
<div id="events">
  <% @upcoming_new_events.each do |event| %>
    <%= render event %>
    <p>
      <%= link_to "View event details", event %> 
      <br/>
      <%= link_to "Register for event", new_registration_path(event_id: event.id) %>
    </p>
  <% end %>
</div>

<%= link_to "View Your Existing Events", my_events_path %>
