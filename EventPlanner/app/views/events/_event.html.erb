<div id="<%= dom_id event %>">
  <div>
    <strong>Name:</strong>
    <%= event.name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= event.description %>
  </div>

  <div>
    <strong>Date:</strong>
    <%= event.date %>
  </div>

  <div>
    <strong>Location:</strong>
    <%= event.location %>
  </div>

  <div>
    <strong>Preview img:</strong>
    <%= event.preview_img %>
  </div>

  <div>
    <strong>Organizer:</strong>
    <%= event.organizer_id %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= event.category_id %>
  </div>

</div>
