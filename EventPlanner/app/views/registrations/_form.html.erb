<%= form_with(model: registration) do |form| %>
  <% if registration.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(registration.errors.count, "error") %> prohibited this registration from being saved:</h2>
      <ul>
        <% registration.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <strong>Your Name:</strong> <%= current_user.username %>
  </p>

  <p>
    <strong>Event:</strong> <%= registration.event&.name %>
    <%= form.hidden_field :event_id %>
  </p>

  <div>
    <%= form.label "Leave an optional note for the organizers:", style: "display: block" %>
    <%= form.text_area :notes %>
  </div>

  <div>
    <%= form.submit "Complete Registration" %>
  </div>
<% end %>